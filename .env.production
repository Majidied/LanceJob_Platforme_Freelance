# Production Environment Configuration for LanceJob

# Database Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/lancejob?authSource=admin
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password123
REDIS_DB=0

# API Configuration
PORT=5000
NODE_ENV=production
API_URL=http://backend:5000
RECOMMENDATION_API_URL=http://recommendation-api:5001
RECOMMENDATION_API_TIMEOUT=30000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-64-char-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# Email Configuration (Update with your email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@lancejob.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/app/uploads

# Recommendation System
RECOMMENDATION_CACHE_TTL=600
ENABLE_INTERACTION_TRACKING=true
MODEL_RETRAIN_INTERVAL=7200
CONTENT_WEIGHT=0.6
COLLABORATIVE_WEIGHT=0.4
MIN_CONFIDENCE_SCORE=0.3
MAX_RECOMMENDATIONS=50

# Performance Settings
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_COMPRESSION=true
ENABLE_CORS=true

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
LOG_FILE_PATH=/app/logs
MAX_LOG_FILES=5
MAX_LOG_SIZE=10485760

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-in-production
CORS_ORIGIN=http://localhost
HELMET_ENABLED=true

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_BATCH_SIZE=1000
ANALYTICS_FLUSH_INTERVAL=300000

# Background Jobs
ENABLE_BACKGROUND_JOBS=true
JOB_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=5000

# Health Checks
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
MONGODB_HEALTH_CHECK=true
REDIS_HEALTH_CHECK=true
RECOMMENDATION_API_HEALTH_CHECK=true

# Payment Integration (Update with your payment provider details)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# External APIs
SENDGRID_API_KEY=your_sendgrid_api_key
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=lancejob-uploads

# Frontend Configuration
VITE_API_URL=http://localhost:5000
VITE_RECOMMENDATION_POLLING_INTERVAL=30000
VITE_ENABLE_ANALYTICS=true
VITE_SENTRY_DSN=your_sentry_dsn_for_frontend_monitoring

# Monitoring and Observability
SENTRY_DSN=your_sentry_dsn_for_backend_monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_RECOMMENDATIONS=true
ENABLE_REAL_TIME_CHAT=true
ENABLE_VIDEO_CALLS=false
ENABLE_NOTIFICATIONS=true
ENABLE_FILE_UPLOAD=true

# API Rate Limiting by Endpoint
AUTH_RATE_LIMIT=10
RECOMMENDATION_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=5
EMAIL_RATE_LIMIT=3

# Caching Configuration
CACHE_DEFAULT_TTL=300
CACHE_USER_PROFILE_TTL=1800
CACHE_MISSION_LIST_TTL=600
CACHE_RECOMMENDATION_TTL=600

# Database Connection Pool
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=30000
DB_SOCKET_TIMEOUT=45000

# Redis Configuration
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000
REDIS_RETRY_DELAY_ON_FAIL_OVER=100
REDIS_MAX_RETRIES_PER_REQUEST=3
